--- !u!114 &1547257770
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1547257769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0a1b7cacee55d974ca7610e203a41ca2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelGroup: {fileID: 1848599188}
  subtitleText: {fileID: 360488238}
  lines:
  - '  "...Where am I?"'
  - '"This... this is my room."'
  - '"The desk, the bed, the shelves... everything looks so familiar."'
  - '"But something feels off."'
  - '"Why... why am I so small?"'
  - " \"It feels like I\u2019m trapped inside one of my own designs.\""
  - '"A world I built... and forgot how to escape from."'
  - '"I need to find a way out of here."'
  typingSpeed: 0.04
  lineDelay: 1.2
  fadeTime: 1
  canSkip: 1
