  m_Script: {fileID: 11500000, guid: 0a1b7cacee55d974ca7610e203a41ca2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panelGroup: {fileID: 1086147298}
  subtitleText: {fileID: 2082993140}
  lines:
  - "These are\u2026 buildings? "
  - 'Half-built. Half-forgotten. '
  - "Once, I dreamed of skylines \u2014 of buildings that could touch the clouds."
  - "I don\u2019t remember when I stopped building. Or why."
  - "But this site feels familiar \u2014 like a blueprint drawn from my memories."
  - "Maybe if I build it again\u2026 I\u2019ll remember who I was."
  typingSpeed: 0.06
  lineDelay: 1.6
  fadeTime: 0.8
  canSkip: 1
